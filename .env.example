# Copy this file to `.env` in the project root and fill in what you have. Every value is optional:
# the app works without any of them (rule-based language parser + text-only posters).
# NEVER commit your real .env file and never paste keys into chat or into frontend code.

# Claude (natural-language understanding + reply wording). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
# Only if the API says your key is "not scoped to a workspace": the workspace ID (starts with wrkspc_), from console.anthropic.com > Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=
# Model used for chat. Smaller/cheaper options: claude-sonnet-5-5, claude-haiku-4-5
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_TIMEOUT_S=30

# Movie posters (optional). Free key from themoviedb.org/settings/api (v3 key or v4 read token)
TMDB_API_KEY=

# Browser origin(s) allowed by the API's CORS policy; comma-separated for several (e.g. "https://kinema.co.in,https://www.kinema.co.in")
FRONTEND_ORIGIN=http://localhost:3000

# --- Only for a public deployment (see docs/DEPLOYMENT.md). All optional; leave unset locally.
# Makes the site private: visitors must type this code. Choose any phrase.
ACCESS_CODE=
# Max Claude calls per UTC day for the whole site (0 = unlimited). After that the site answers in offline mode.
CLAUDE_DAILY_LIMIT=400
# Requests per minute per visitor: chat/recommend/compare, and everything else.
RATE_HEAVY_PER_MIN=20
RATE_LIGHT_PER_MIN=240
